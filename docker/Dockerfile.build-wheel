# Standalone build image for Linux wheels — no ghcr.io required.
# Installs Rust + maturin inside python:3.11-slim, builds the wheel,
# then copies it to the host via a mounted target/wheels volume.
#
# Usage (from repo root):
#   docker build -f docker/Dockerfile.build-wheel -t pdf-inspector-builder .
#   docker run --rm -v "$(pwd)/target/wheels:/io/target/wheels" pdf-inspector-builder

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (needed to compile pyo3 extensions)
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
    && chmod -R a+w /usr/local/rustup /usr/local/cargo

RUN pip install --no-cache-dir "maturin>=1.0,<2.0"

WORKDIR /io
COPY . .

RUN maturin build --release

CMD ["sh", "-c", "echo 'Wheels in target/wheels:' && ls target/wheels/*.whl"]
